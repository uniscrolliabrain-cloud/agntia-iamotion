{
  "name": "@agntia/motion",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "build:demo": "vite build apps/ui-lab --base /agntia-iamotion/",
    "test": "tsc -p tsconfig.json && node --test --test-isolation=none",
    "audit:library": "node lab/scripts/audit-baseline.mjs",
    "plan:library": "node lab/scripts/plan-library-migration.mjs",
    "schemas:library": "node lab/scripts/export-library-schemas.mjs",
    "render:ceramic-mail": "bash lab/scripts/render-ceramic-mail.sh",
    "stage:library": "node lab/scripts/stage-library-snapshot.mjs",
    "export:ontology": "node lab/scripts/export-ontology.mjs",
    "reconcile:library": "node lab/scripts/reconcile-library.mjs",
    "plan:claims": "node lab/scripts/plan-legacy-claims.mjs",
    "extract:usage": "node lab/scripts/extract-git-usage.mjs",
    "report:context": "node lab/scripts/report-business-context.mjs",
    "inspect:images": "python lab/scripts/inspect-library-images.py",
    "report:prompts": "node lab/scripts/report-prompt-intent.mjs"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "parse5": "8.1.1",
    "postcss": "8.5.33",
    "postcss-value-parser": "4.2.0",
    "three": "0.187.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
