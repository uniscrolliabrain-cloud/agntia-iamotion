{
  "name": "@agntia/motion",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "exports": {
    ".": "./dist/index.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
